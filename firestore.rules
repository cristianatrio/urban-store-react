rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Categorias: solo lectura (se gestionan desde la consola de Firebase)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // Catalogo: lectura publica. Las unicas escrituras permitidas mueven
    // unidades entre stock y vendidos (sold): una venta al generar la orden y
    // una devolucion cuando se saca un producto al modificar un pedido.
    match /items/{itemId} {
      allow read: if true;
      allow update: if isSale() || isReturn();
      allow create, delete: if false;
    }

    // stock + sold nunca crece: el stock no puede superar el inventario cargado
    function keepsInventory() {
      return request.resource.data.stock is int
        && request.resource.data.sold is int
        && request.resource.data.stock >= 0
        && request.resource.data.sold >= 0
        && request.resource.data.stock + request.resource.data.sold
          == resource.data.stock + resource.data.get('sold', 0);
    }

    function isSale() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'sold'])
        && keepsInventory()
        && request.resource.data.stock < resource.data.stock;
    }

    // Devolucion: solo en la misma operacion que marca el pedido como modificado
    function isReturn() {
      let order = /databases/$(database)/documents/orders/$(request.resource.data.lastReturn);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'sold', 'lastReturn'])
        && keepsInventory()
        && request.resource.data.stock > resource.data.stock
        && request.resource.data.lastReturn is string
        && get(order).data.status == 'generada'
        && getAfter(order).data.status == 'modificada';
    }

    // Ordenes: se pueden crear y consultar por id ("Mis ordenes"), pero no
    // listar ni borrar. La unica modificacion es marcarla como 'modificada'
    // al generar su version nueva.
    match /orders/{orderId} {
      allow get: if true;
      allow list: if false;
      allow create: if isValidOrder(request.resource.data, orderId);
      allow update: if isReplacedOrder(orderId);
      allow delete: if false;
    }

    function isValidOrder(order, orderId) {
      return hasShippingBreakdown(order, orderId)
        && order.status == 'generada'
        && order.date == request.time
        && order.items is list
        && order.items.size() > 0
        && order.buyer.keys().hasAll(['nombre', 'apellido', 'telefono', 'email'])
        && order.buyer.email is string
        && order.buyer.email.matches('.+@.+[.].+');
    }

    // Orden con el detalle de envio: total = subtotal + envio.
    // basedOn (opcional): el pedido original cuando esta orden lo modifica.
    function hasShippingBreakdown(order, orderId) {
      return order.keys().hasOnly(['buyer', 'items', 'subtotal', 'shipping', 'total', 'date', 'status', 'basedOn'])
        && order.keys().hasAll(['buyer', 'items', 'subtotal', 'shipping', 'total', 'date', 'status'])
        && order.subtotal is number
        && order.subtotal > 0
        && order.shipping is number
        && order.shipping >= 0
        && order.total == order.subtotal + order.shipping
        && (!('basedOn' in order) || replacesOrder(order, orderId));
    }

    // La version nueva conserva el comprador y el original pasa a 'modificada'
    // apuntando a ella en la misma operacion.
    function replacesOrder(order, orderId) {
      let original = /databases/$(database)/documents/orders/$(order.basedOn);
      return order.basedOn is string
        && get(original).data.status == 'generada'
        && get(original).data.buyer == order.buyer
        && getAfter(original).data.replacedBy == orderId;
    }

    function isReplacedOrder(orderId) {
      let replacement = /databases/$(database)/documents/orders/$(request.resource.data.replacedBy);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'replacedBy'])
        && resource.data.status == 'generada'
        && request.resource.data.status == 'modificada'
        && request.resource.data.replacedBy is string
        && !exists(replacement)
        && getAfter(replacement).data.basedOn == orderId;
    }
  }
}
